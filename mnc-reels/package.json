{
  "name": "mnc-reels",
  "version": "1.0.0",
  "private": true,
  "description": "Editor de reels de Manuel NoCode (MNC): plantilla Remotion 1080x1920 + scripts del flujo",
  "scripts": {
    "audio": "node scripts/gen_sfx.mjs",
    "demo": "python3 scripts/demo.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Reel --codec h264 --crf 17",
    "still": "remotion still src/index.ts Reel",
    "cover": "remotion still src/index.ts Portada",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
